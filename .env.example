# Setup generates .env automatically. Do not copy these password placeholders.
DB_ROOT_PASSWORD=replace-with-a-local-random-password
DB_PASSWORD=replace-with-a-local-random-password
ADMIN_PASSWORD=replace-with-a-strong-local-admin-password
# Choose ports before the first setup; saved store URLs use these ports.
WOO_PORT=8091
PRESTA_PORT=8092
MAGENTO_PORT=8093
